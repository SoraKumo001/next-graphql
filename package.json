{
  "name": "next-graphql",
  "version": "1.0.0",
  "keywords": [
    "nextjs",
    "nexus",
    "prisma",
    "pothos",
    "urql"
  ],
  "author": "SoraKumo",
  "license": "MIT",
  "description": "",
  "scripts": {
    "dev:next": "next",
    "dev:docker": "docker compose -p next-graphql -f docker/docker-compose.yml up -d",
    "build": "npm run build:mapper && prisma generate && npm run typecheck && next build",
    "build:mapper": "tsc -p packages/graphql-content-mapper/tsconfig.json",
    "typecheck": "npm run build:mapper && tsc --runExternalCode --noEmit",
    "start": "next start",
    "lint": "eslint --fix ./src",
    "lint:fix": "eslint --fix ./src",
    "prisma:reset": "prisma migrate reset -f",
    "prisma:migrate": "prisma format && prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@apollo/explorer": "^3.7.4",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-prisma": "^4.17.0",
    "@pothos/plugin-prisma-utils": "^1.3.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-libraries/next-exchange-ssr": "^1.0.10",
    "dotenv": "^18.0.8",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.6",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "pothos-prisma-generator": "^1.3.11",
    "pothos-query-generator": "^1.0.1",
    "pothos-schema-exporter": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "graphql-content-mapper": "file:./packages/graphql-content-mapper",
    "postcss": "^8.5.31",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.1.0-beta"
  },
  "main": "index.js",
  "repository": "https://github.com/SoraKumo001/next-graphql"
}
