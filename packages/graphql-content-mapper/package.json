{
  "name": "graphql-content-mapper",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/index.js"
      ],
      "outputExtensions": {
        ".graphql": ".js"
      }
    }
  }
}
